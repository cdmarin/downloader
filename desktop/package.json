{
  "name": "clipsaver-desktop",
  "productName": "ClipSaver",
  "version": "1.0.0",
  "description": "Descarga videos y audios de cualquier plataforma",
  "author": "cdmarin",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cdmarin.clipsaver",
    "productName": "ClipSaver",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      { "from": "..", "to": ".", "filter": ["server.js"] },
      { "from": "../public", "to": "public" }
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**",
      "node_modules/ffmpeg-static/**"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ClipSaver-Setup-${version}.exe",
      "shortcutName": "ClipSaver"
    },
    "portable": {
      "artifactName": "ClipSaver-portable-${version}.exe"
    }
  }
}
